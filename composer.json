{
    "name": "manuxi/sulu-icon-picker-bundle",
    "description": "Enhances Sulu's own single_icon_selection field: a real icon preview in the form and a Twig function to render the stored icon, on top of Sulu's built-in icon_sets/providers",
    "type": "symfony-bundle",
    "homepage": "https://github.com/manuxi/SuluIconPickerBundle",
    "license": "MIT",
    "keywords": [
        "sulu",
        "admin",
        "content-type",
        "icon",
        "single_icon_selection",
        "icon-sets",
        "Property Resolvers"
    ],
    "authors": [
        {
            "name": "Manuxi",
            "homepage": "https://github.com/manuxi"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "require": {
        "php": "^8.1",
        "sulu/sulu": "^3.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluIconPickerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluIconPickerBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-js": "npx jest",
        "test-js-coverage": "npx jest --coverage",
        "test-all": [
            "@test",
            "@test-js"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
